# ─── LLM / Embeddings API Keys ───────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL='https://api.groq.com/openai/v1'

# ─── Database (Neon serverless Postgres) ──────────────────────────────────────
# Paste the direct (unpooled) connection string from your Neon project dashboard.
# Use the direct URL (not pooler) to avoid PgBouncer prepared-statement conflicts.
# Format: postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&channel_binding=require
# Note: config.py rewrites sslmode= → ssl= automatically for asyncpg.
# Note: pgvector must be enabled before running migrations:
#   CREATE EXTENSION IF NOT EXISTS vector;
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql+asyncpg://local_user:local_password@localhost:5433/local_db

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Ingestion ────────────────────────────────────────────────────────────────
# 'auto' detects CUDA at startup and falls back to CPU if unavailable.
# Override with 'cuda' or 'cpu' to force a specific device.
# GPU is optional — CPU-only environments are fully supported (slower for OCR).
OCR_DEVICE=auto

# ─── Retrieval / Embeddings ───────────────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBED_BATCH_SIZE=256
EMBEDDING_MAX_RETRIES=3
LLM_MODEL=gpt-4o-mini
DENSE_RETRIEVAL_TOP_K=25
RERANKER_TOP_N=5
REFUSAL_SCORE_THRESHOLD=0.5

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=