# ─── LLM / Embeddings API Keys ───────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-...

# ─── Database (Neon serverless Postgres) ──────────────────────────────────────
# Use the direct (unpooled) connection string from your Neon project dashboard
# to avoid PgBouncer prepared-statement conflicts with asyncpg.
# Format: postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
# Note: pgvector must be enabled on this database before running migrations:
#   CREATE EXTENSION vector;
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Ingestion ────────────────────────────────────────────────────────────────
# 'auto' detects CUDA at startup and falls back to CPU if unavailable.
# Override with 'cuda' or 'cpu' to force a specific device.
# GPU is optional — CPU-only environments are fully supported (slower for OCR).
OCR_DEVICE=auto

# ─── Retrieval / Embeddings ───────────────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBED_BATCH_SIZE=256
EMBEDDING_MAX_RETRIES=3
LLM_MODEL=gpt-4o-mini
DENSE_RETRIEVAL_TOP_K=25
RERANKER_TOP_N=5
REFUSAL_SCORE_THRESHOLD=0.72

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
