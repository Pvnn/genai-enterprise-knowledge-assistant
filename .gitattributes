# Normalize line endings to LF in the repo
* text=auto eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Binaries
*.pdf binary
*.png binary
*.jpg binary
*.bin binary
*.pt binary
*.onnx binary
